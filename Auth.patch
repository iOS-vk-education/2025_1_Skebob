+//
+//  Created by Dmitriy Permyakov on 08.12.2025.
+//
+
+import Foundation
+import SwiftUI
+
+final class AuthScreenViewModel: Sendable {
+
+    private let state: AuthScreenViewState
+
+    @MainActor
+    private var users: [User] = []
+
+    @MainActor
+    init(state: AuthScreenViewState) {
+        self.state = state
+    }
+}
+
+// MARK: - AuthScreenViewOutput
+
+extension AuthScreenViewModel: AuthScreenViewOutput {
+
+    func onTapLoginButton() {
+        print("[DEBUG]: \(#function)")
+
+        // Валидация
+        if let inputError = validateInputData(email: state.email, password: state.password) {
+            state.errorMessage = inputError
+            return
+        }
+
+        // Обновляем UI
+        state.isLoading = true
+        state.errorMessage = nil
+
+        // Идём в сеть
+        Task {
+            do {
+                let user = try await login(email: state.email, password: state.password)
+                UserDefaults.standard.set(true, forKey: "isLoggedIn")
+            } catch {
+                print("[DEBUG]: \(error)")
+            }
+        }
+    }
+}
+
+// MARK: - Helpers
+
+private extension AuthScreenViewModel {
+
+    // FIXME: Требуется вынести в сервис. В некст итеракциях расскажу подробнее. Пока так
+    @MainActor
+    func login(email: String, password: String) async throws -> User {
+        // Имитация запроса в сеть
+        try await Task.sleep(for: .seconds(1.5))
+
+        return User(email: "admin@example.com", password: "password123")
+    }
+
+    @MainActor
+    private func validateInputData(email: String, password: String) -> String? {
+        guard !email.isEmpty else {
+            return "Введите e-mail"
+        }
+
+        guard !password.isEmpty else {
+            return "Введите пароль"
+        }
+
+        guard email.contains("@") && email.contains(".") else {
+            return "Введите действительный e-mail"
+        }
+
+        guard password.count >= 6 else {
+            return "Пароль не может быть меньше 6 символов"
+        }
+
+        return nil
+    }
+}
